9.8 645.1 C794.7 648.6 789.0 651.5 789.0 650.6 C789.0 650.5 789.9 647.7 791.0 644.4 C793.6 636.9 796.0 627.9 797.0 621.7 C797.7 616.9 797.7 616.9 795.3 617.5 C793.3 618.0 792.9 617.6 792.4 615.2 L791.8 612.3 L785.7 615.6 C776.1 620.8 775.6 620.5 776.3 611.5 C776.9 602.8 776.3 602.3 771.9 608.7 C764.1 619.9 749.1 633.4 738.3 638.9 C731.7 642.2 731.7 641.8 735.9 628.3 C743.7 603.6 745.0 574.0 738.3 574.0 C737.5 574.0 732.6 576.1 727.4 578.6 C717.7 583.3 715.0 583.6 715.0 580.1 C715.0 579.0 713.8 574.4 712.4 570.0 L709.9 561.8 L706.2 562.5 C687.5 566.0 670.2 580.3 661.4 599.5 C658.8 605.1 658.8 605.2 660.3 610.8 C661.2 613.9 662.4 620.5 663.0 625.5 C663.7 630.5 664.3 635.0 664.5 635.7 C664.9 636.8 668.0 636.4 673.6 634.6 C675.7 634.0 675.8 634.2 676.2 645.2 C676.5 655.0 676.9 657.3 679.3 662.5 C685.6 676.0 687.8 676.0 704.0 662.6 C711.0 656.8 711.6 657.7 710.0 670.9 C708.2 684.5 709.2 691.8 712.8 692.2 C717.5 692.8 727.1 687.2 739.4 676.6 L745.3 671.5 L744.7 676.8 C743.9 683.7 738.4 697.0 732.7 705.8 C728.3 712.6 728.1 713.1 729.5 715.7 C732.6 721.5 730.2 726.6 721.2 733.4 C713.7 739.1 708.5 744.3 701.5 753.0 C696.8 758.9 695.5 760.1 695.2 758.5 C694.5 754.1 694.2 754.0 688.3 757.6 C682.4 761.1 670.9 765.2 663.2 766.5 L658.9 767.2 L662.9 761.8 L667.0 756.5 L653.2 755.9 C640.4 755.3 629.5 753.9 624.9 752.1 C623.1 751.5 623.9 750.7 630.0 746.7 C634.6 743.5 636.8 741.5 636.3 740.7 C634.0 736.9 617.6 716.6 610.1 708.2 C592.4 688.5 571.3 673.5 552.1 666.9 L546.7 665.0 L540.1 668.6 C520.1 679.7 507.6 693.2 502.4 709.4 C495.4 731.4 502.4 768.9 518.5 794.9 L521.2 799.2 L518.9 798.5 C509.3 795.5 486.6 781.3 475.0 770.9 C471.3 767.7 468.1 765.0 467.7 765.0 C466.6 765.0 467.9 788.6 469.5 798.1 C472.8 817.4 480.6 838.9 490.4 855.4 C493.0 859.7 494.9 863.4 494.8 863.5 C494.6 863.6 490.0 861.8 484.5 859.5 Z" />
            </Grid>
            <!-- the strip at the top while an archive is open: a few stars and a small wolf (the silhouette of the chibi wolf of the web site, drawn by the owner) that fade out downwards -->
            <Grid x:Name="ArchiveScene" Visibility="Collapsed" VerticalAlignment="Top" Height="120">
                <Canvas x:Name="ArchiveStars" />
                <Path x:Name="WolfStrip" HorizontalAlignment="Right" VerticalAlignment="Top" Stretch="Uniform" Height="96" Margin="0,8,28,0"
                      Data="M 392 128 C 402 82, 424 44, 442 22 C 448 52, 444 92, 434 126 Z M 382 355 L 392 468 C 408 470, 422 478, 424 492 C 424 500, 412 504, 388 504 L 356 504 L 350 365 Z M 225 355 C 238 388, 250 422, 265 468 C 280 470, 294 478, 295 492 C 295 500, 282 504, 258 504 L 232 504 C 220 462, 202 425, 188 385 Z M 342 18 C 365 45, 385 85, 398 125 C 412 124, 428 128, 442 136 L 452 146 C 478 142, 508 136, 535 130 C 545 128, 550 134, 546 144 C 540 162, 524 178, 502 186 L 468 194 L 504 202 C 508 212, 496 224, 476 230 C 456 236, 438 238, 424 242 C 448 258, 466 280, 478 302 L 452 304 C 464 326, 466 350, 458 372 L 438 366 C 425 385, 405 398, 382 405 L 374 478 C 392 480, 406 488, 408 504 C 408 512, 395 516, 368 516 L 328 516 C 320 516, 316 508, 316 492 L 314 388 L 296 396 L 304 378 C 268 370, 235 375, 208 392 C 192 418, 178 448, 174 478 C 190 480, 204 488, 206 504 C 206 512, 192 516, 165 516 L 128 516 C 120 516, 115 508, 118 492 C 124 458, 136 428, 152 402 L 132 396 C 140 380, 146 362, 148 345 C 112 368, 72 378, 36 362 C 16 352, 8 332, 16 312 C 24 324, 42 328, 62 322 C 32 302, 18 272, 24 238 C 36 254, 58 264, 84 264 C 68 244, 66 218, 78 198 C 98 214, 128 232, 158 258 C 188 238, 224 228, 262 222 L 246 206 C 268 196, 290 190, 310 186 L 288 170 C 304 156, 320 144, 336 135 L 318 122 C 328 112, 336 104, 344 98 C 334 72, 334 42, 342 18 Z" />
            </Grid>
        </Grid>

    <Grid x:Name="RootGrid" AllowDrop="True" KeyboardAcceleratorPlacementMode="Hidden" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop" SizeChanged="OnRootSizeChanged">
        <!-- Keyboard shortcuts use XAML KeyboardAccelerator: they work also on an empty part of the list / tree, or with no focus at all.
             PlacementMode=Hidden keeps it from showing a hint like "Ctrl + F" on mouse hover -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <!-- The "card" of the settings page: one setting per row -->
            <Style x:Key="SettingCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            </Style>
            <!-- Item templates and panels of the list / icon view (switched at run time for EntryGrid) -->
            <DataTemplate x:Key="ListItemTemplate" x:DataType="local:EntryRow">
                <StackPanel Orientation="Horizontal" Spacing="4" Width="250" ToolTipService.ToolTip="{x:Bind Name}" Loaded="OnTemplateLoaded">
                    <CheckBox x:Name="RowCheck" Width="28" MinWidth="0" Padding="0" IsTabStop="False"
                              Opacity="{x:Bind CheckOpacity, Mode=OneWay}" IsChecked="{x:Bind IsSelected, Mode=OneWay}" AutomationProperties.Name="main.select" />
                    <Grid Width="22" Height="22" VerticalAlignment="Center" Visibility="{x:Bind ListGlyphVisibility, Mode=OneWay}">
                        <Border CornerRadius="5" Background="{x:Bind GlyphBrush}" Opacity="{x:Bind ChipOpacity, Mode=OneWay}" />
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{x:Bind GlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <Image Source="{x:Bind ArchiveIcon}" Width="18" Height="18" VerticalAlignment="Center" Visibility="{x:Bind ListArchiveVisibility, Mode=OneWay}" />
                    <Image Source="{x:Bind ShellIcon, Mode=OneWay}" Width="18" Height="18" VerticalAlignment="Center" Visibility="{x:Bind ShellIconVisibility, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="180" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="IconItemTemplate" x:DataType="local:EntryRow">
                <Grid Width="{x:Bind ItemWidth}" Height="{x:Bind ItemHeight}" ToolTipService.ToolTip="{x:Bind Name}" Loaded="OnTemplateLoaded">
                    <StackPanel Padding="4,8" Spacing="6">
                        <Grid Height="{x:Bind BoxHeight}">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="{x:Bind GlyphSize}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Foreground="{x:Bind GlyphBrush}"
                                      Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                            <Image Source="{x:Bind ArchiveIconLarge}" Width="{x:Bind IconSize}" Height="{x:Bind IconSize}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                   Visibility="{x:Bind ArchiveIconVisibility, Mode=OneWay}" />
                            <Image Source="{x:Bind ShellIconLarge, Mode=OneWay}" Width="{x:Bind IconSize}" Height="{x:Bind IconSize}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                   Visibility="{x:Bind ShellIconLargeVisibility, Mode=OneWay}" />
                            <!-- a thin plate under the picture: pictures with a transparent background (PNG, GIF) still show where they end; no blur or shadow (scrolling stays fast) -->
                            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" BorderThickness="1" CornerRadius="2"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Visibility="{x:Bind ThumbVisibility, Mode=OneWay}">
                                <Image Source="{x:Bind ThumbSource, Mode=OneWay}" Stretch="Uniform" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind DisplayName}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="{x:Bind NameLines}"
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                    </StackPanel>
                    <CheckBox x:Name="RowCheck" Width="28" MinWidth="0" Padding="0" IsTabStop="False" HorizontalAlignment="Left" VerticalAlignment="Top"
                              Opacity="{x:Bind CheckOpacity, Mode=OneWay}" IsHitTestVisible="{x:Bind CheckHitTest, Mode=OneWay}" IsChecked="{x:Bind IsSelected, Mode=OneWay}" AutomationProperties.Name="main.select" />
                </Grid>
            </DataTemplate>
            <ItemsPanelTemplate x:Key="ListPanel"><ItemsWrapGrid Orientation="Vertical" /></ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="IconPanel"><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
            <!-- Task row: moon phase progress (0% new moon -> 100% full moon; done = check mark, failed = light red, cancelled = grey) -->
            <DataTemplate x:Key="TaskRowTemplate" x:DataType="local:TaskRow">
                <Grid ColumnSpacing="12" Padding="10,10,0,10" Loaded="OnTemplateLoaded">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- the glow of the moon when the task ends (MainWindow::GlowMoon): invisible until then; it may spill over the moon -->
                    <Ellipse x:Name="MoonGlow" Width="40" Height="40" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><CompositeTransform /></Ellipse.RenderTransform>
                        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FFF4F8FF" Offset="0.4" /><GradientStop Color="#00F4F8FF" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                    </Ellipse>
                    <Viewbox Width="40" Height="40" VerticalAlignment="Center">
                        <Grid Width="40" Height="40">
                            <Ellipse Width="40" Height="40" Fill="#0A1030" Stroke="#2B3C7C" StrokeThickness="1" />
                            <Path Data="{x:Bind LitGeometry, Mode=OneWay}" Fill="{x:Bind LitBrush, Mode=OneWay}" />
                            <Ellipse Width="38" Height="38" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" Opacity="0.9" />
                            <Ellipse Width="38" Height="38" Stroke="#FF6B6B" StrokeThickness="2.5" Visibility="{x:Bind RingErrorVisibility, Mode=OneWay}" />
                            <ProgressRing Width="20" Height="20" IsActive="{x:Bind IsIndeterminate, Mode=OneWay}" Visibility="{x:Bind SpinnerVisibility, Mode=OneWay}" />
                            <FontIcon Glyph="{x:Bind StateGlyph, Mode=OneWay}" FontSize="17" Foreground="{x:Bind StateGlyphBrush, Mode=OneWay}"
                                      Visibility="{x:Bind StateGlyphVisibility, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Viewbox>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Opacity="0.75" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Progress, Mode=OneWay}" IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" Height="6" MinHeight="6" CornerRadius="3" Margin="0,4,0,0" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Background="#26FFFFFF" >
                            <ProgressBar.Resources><x:Double x:Key="ProgressBarTrackHeight">6</x:Double><x:Double x:Key="ProgressBarMinHeight">6</x:Double><CornerRadius x:Key="ControlCornerRadius">3</CornerRadius></ProgressBar.Resources>
                        </ProgressBar>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Tag="{x:Bind Id}" Click="OnTaskPauseClick" Visibility="{x:Bind PauseVisibility, Mode=OneWay}" ToolTipService.ToolTip="main.pause" AutomationProperties.Name="main.pause"><FontIcon Glyph="&#xE769;" FontSize="14" /></Button>
                        <Button Tag="{x:Bind Id}" Click="OnTaskResumeClick" Visibility="{x:Bind ResumeVisibility, Mode=OneWay}" ToolTipService.ToolTip="main.resume" AutomationProperties.Name="main.resume"><FontIcon Glyph="&#xE768;" FontSize="14" /></Button>
                        <Button Tag="{x:Bind Id}" Click="OnTaskCancelClick" Visibility="{x:Bind CancelVisibility, Mode=OneWay}" ToolTipService.ToolTip="main.cancel" AutomationProperties.Name="main.cancel"><FontIcon Glyph="&#xE711;" FontSize="14" /></Button>
                        <Button Tag="{x:Bind OutputPath, Mode=OneWay}" Click="OnTaskOpenFolderClick" Visibility="{x:Bind OpenFolderVisibility, Mode=OneWay}" ToolTipService.ToolTip="main.open_folder" AutomationProperties.Name="main.open_folder"><FontIcon Glyph="&#xE838;" FontSize="14" /></Button>
                        <Button Tag="{x:Bind Id}" Click="OnTaskTestClick" Visibility="{x:Bind TestVisibility, Mode=OneWay}" ToolTipService.ToolTip="main.test_integrity" AutomationProperties.Name="main.test_integrity"><FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" /></Button>
                        <Button Tag="{x:Bind Id}" Click="OnTaskDeleteClick" Visibility="{x:Bind DeleteVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind DeleteLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind DeleteLabel, Mode=OneWay}"><FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" /></Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <!-- For the compact window: big moon, big title -->
            <DataTemplate x:Key="TaskHeroTemplate" x:DataType="local:TaskRow">
                <Grid ColumnSpacing="20" Padding="22,22,0,22" Loaded="OnTemplateLoaded">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- the glow of the moon when the task ends (MainWindow::GlowMoon): invisible until then; it may spill over the moon -->
                    <Ellipse x:Name="MoonGlow" Width="92" Height="92" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><CompositeTransform /></Ellipse.RenderTransform>
                        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FFF4F8FF" Offset="0.4" /><GradientStop Color="#00F4F8FF" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                    </Ellipse>
                    <Viewbox Width="92" Height="92" VerticalAlignment="Center">
                        <Grid Width="40" Height="40">
                            <Ellipse Width="40" Height="40" Fill="#0A1030" Stroke="#2B3C7C" StrokeThickness="0.8" />
                            <Path Data="{x:Bind LitGeometry, Mode=OneWay}" Fill="{x:Bind LitBrush, Mode=OneWay}" />
                            <Ellipse Width="38.4" Height="38.4" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.6" Opacity="0.95" />
                            <Ellipse Width="38.4" Height="38.4" Stroke="#FF6B6B" StrokeThickness="2" Visibility="{x:Bind RingErrorVisibility, Mode=OneWay}" />
                            <ProgressRing Width="20" Height="20" IsActive="{x:Bind IsIndeterminate, Mode=OneWay}" Visibility="{x:Bind SpinnerVisibility, Mode=OneWay}" />
                            <FontIcon Glyph="{x:Bind StateGlyph, Mode=OneWay}" FontSize="17" Foreground="{x:Bind StateGlyphBrush, Mode=OneWay}"
                                      Visibility="{x:Bind StateGlyphVisibility, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Viewbox>
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Opacity="0.8" TextWrapping="Wrap" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Progress, Mode=OneWay}" IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" Height="8" MinHeight="8" CornerRadius="4" Margin="0,4,0,0" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Background="#26FFFFFF" >
                            <ProgressBar.Resources><x:Double x:Key="ProgressBarTrackHeight">8</x:Double><x:Double x:Key="ProgressBarMinHeight">8</x:Double><CornerRadius x:Key="ControlCornerRadius">4</CornerRadius></ProgressBar.Resources>
                        </ProgressBar>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                            <StackPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Padding" Value="8,5,8,6" /></Style>
                            </StackPanel.Resources>
                            <Button Tag="{x:Bind Id}" Click="OnTaskPauseClick" Visibility="{x:Bind PauseVisibility, Mode=OneWay}" AutomationProperties.Name="main.pause"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE769;" FontSize="14" /><TextBlock Text="main.pause" /></StackPanel></Button>
                            <Button Tag="{x:Bind Id}" Click="OnTaskResumeClick" Visibility="{x:Bind ResumeVisibility, Mode=OneWay}" AutomationProperties.Name="main.resume"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock Text="main.resume" /></StackPanel></Button>
                            <Button Tag="{x:Bind Id}" Click="OnTaskCancelClick" Visibility="{x:Bind CancelVisibility, Mode=OneWay}" AutomationProperties.Name="main.cancel"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE711;" FontSize="14" /><TextBlock Text="main.cancel" /></StackPanel></Button>
                            <Button Tag="{x:Bind OutputPath, Mode=OneWay}" Click="OnTaskOpenFolderClick" Visibility="{x:Bind OpenFolderVisibility, Mode=OneWay}" AutomationProperties.Name="main.open_folder"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE838;" FontSize="14" /><TextBlock Text="main.open_folder" /></StackPanel></Button>
                            <Button Tag="{x:Bind Id}" Click="OnTaskTestClick" Visibility="{x:Bind TestVisibility, Mode=OneWay}" AutomationProperties.Name="main.test_integrity"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" /><TextBlock Text="main.test_integrity" /></StackPanel></Button>
                            <Button Tag="{x:Bind Id}" Click="OnTaskDeleteClick" Visibility="{x:Bind DeleteVisibility, Mode=OneWay}" AutomationProperties.Name="{x:Bind DeleteLabel, Mode=OneWay}"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" /><TextBlock Text="{x:Bind DeleteLabel, Mode=OneWay}" /></StackPanel></Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ContentRow" Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image x:Name="TitleLogo" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock x:Name="AppTitleText" Text="LycanZip" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="SettingsButton" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,150,0"
                    Width="40" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                    Click="OnSettingsClick" ToolTipService.ToolTip="main.settings" AutomationProperties.Name="main.settings">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="20,0,20,16">

            <!-- Start page: drop area -->
            <Border x:Name="HomePanel"
                    CornerRadius="12" BorderThickness="2"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                <!-- the notice of a new version (optional check, MainWindow::CheckForUpdateAsync) -->
                <Border x:Name="UpdateStrip" Visibility="Collapsed" VerticalAlignment="Top" Margin="12" CornerRadius="6" BorderThickness="1" Padding="10,2,4,2"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                    <Image x:Name="HomeLogo" Width="176" Height="176" HorizontalAlignment="Center" />
                    <TextBlock x:Name="HomeTitle" Text="main.drag_files_here" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="main.archive_open_extract_files_folders"
                               Opacity="0.7" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button x:Name="OpenButton" Content="main.open_archive" Style="{StaticResource AccentButtonStyle}" Click="OnOpenArchiveClick" />
                        <DropDownButton x:Name="NewButton" Content="main.new_archive">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="main.choose_files" Click="OnNewFromFilesClick" />
                                    <MenuFlyoutItem Text="main.choose_folder" Click="OnNewFromFolderClick" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                </StackPanel>
                </Grid>
            </Border>

            <!-- Archive view -->
            <Grid x:Name="ArchivePanel" Visibility="Collapsed" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" MinHeight="40" />
                </Grid.RowDefinitions>

                <!-- First row: extract, preview, view, other options; on the right the file name encoding (only when needed). In a narrow window the buttons keep only the icon (UpdateToolbarText) -->
                <Grid x:Name="ArchiveToolRow" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <SplitButton x:Name="ExtractHereButton" AutomationProperties.Name="main.extract_here" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Click="OnExtractHereSplitClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                            <TextBlock x:Name="ExtractHereText" Text="main.extract_here" />
                        </StackPanel>
                    </SplitButton>
                    <SplitButton x:Name="ExtractToButton" Grid.Column="1" Click="OnExtractToSplitClick" AutomationProperties.Name="main.extract">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8DA;" FontSize="14" />
                            <TextBlock x:Name="ExtractToText" Text="main.extract" />
                        </StackPanel>
                    </SplitButton>
                    <DropDownButton x:Name="AddButton" Grid.Column="2" ToolTipService.ToolTip="main.add_files_folders_archive_you_can" AutomationProperties.Name="main.add_archive">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="AddText" Text="main.add" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="AddFilesItem" Text="main.add_files" Click="OnAddFilesClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="AddFolderItem" Text="main.add_folder" Click="OnAddFolderClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="NewFolderItem" Text="main.new_folder" Click="OnNewFolderClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <DropDownButton x:Name="PreviewButton" Grid.Column="3" AutomationProperties.Name="main.preview">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image x:Name="PreviewWolf" Width="16" Height="16" />
                            <TextBlock x:Name="PreviewText" Text="main.preview" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="PreviewImageItem" Text="main.image_preview" KeyboardAcceleratorTextOverride="Alt+P" Click="OnPreviewImagesClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="PreviewAudioItem" Text="main.audio_preview" KeyboardAcceleratorTextOverride="Alt+Shift+P" Click="OnPreviewAudioClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D6;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                            <DropDownButton x:Name="ViewButton" Grid.Column="4" AutomationProperties.Name="main.view">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE890;" FontSize="14" />
                                    <TextBlock x:Name="ViewText" Text="main.view" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <ToggleMenuFlyoutItem x:Name="FlatToggle" Text="main.list_all" KeyboardAcceleratorTextOverride="Ctrl+Shift+F" Click="OnFlatToggleClick" AutomationProperties.Name="main.list_all" />
                                        <ToggleMenuFlyoutItem x:Name="TreeToggle" Text="main.folder_tree" KeyboardAcceleratorTextOverride="Ctrl+B" Click="OnTreeToggleClick" AutomationProperties.Name="main.folder_tree_toggle" />
                                        <ToggleMenuFlyoutItem x:Name="PaneToggle" Text="main.preview_pane" KeyboardAcceleratorTextOverride="Ctrl+Shift+P" Click="OnPaneToggleClick" AutomationProperties.Name="main.preview_pane_toggle" />
                                        <ToggleMenuFlyoutItem x:Name="MacMetaItem" Text="main.show_macos_metadata" Click="OnMacMetaItemClick" AutomationProperties.Name="main.show_macos_metadata" />
                                        <MenuFlyoutSeparator />
                                        <RadioMenuFlyoutItem x:Name="ViewDetailsItem" Text="main.details" GroupName="view" Tag="v0" Click="OnViewMenuClick" />
                                        <RadioMenuFlyoutItem x:Name="ViewListItem" Text="main.list" GroupName="view" Tag="v1" Click="OnViewMenuClick" />
                                        <!-- the icon view in its four sizes belongs to the same group: choosing a size shows the icons (like File Explorer) -->
                                        <RadioMenuFlyoutItem x:Name="ThumbSmallItem" Text="main.view_small_icons" GroupName="view" Tag="i0" Click="OnViewMenuClick" />
                                        <RadioMenuFlyoutItem x:Name="ThumbMediumItem" Text="main.view_medium_icons" GroupName="view" Tag="i1" Click="OnViewMenuClick" />
                                        <RadioMenuFlyoutItem x:Name="ThumbLargeItem" Text="main.view_large_icons" GroupName="view" Tag="i2" Click="OnViewMenuClick" />
                                        <RadioMenuFlyoutItem x:Name="ThumbHugeItem" Text="main.view_huge_icons" GroupName="view" Tag="i3" Click="OnViewMenuClick" />
                                        <MenuFlyoutSeparator />
                                        <ToggleMenuFlyoutItem x:Name="ThumbsItem" Text="main.show_image_thumbnails_icon_view" Tag="t1" Click="OnViewMenuClick" />
                                        <MenuFlyoutSeparator />
                                        <RadioMenuFlyoutItem x:Name="SortNameItem" Text="main.sort_by_name" GroupName="sort" Tag="s0" Click="OnViewMenuClick" />
                                        <RadioMenuFlyoutItem x:Name="SortSizeItem" Text="main.sort_by_size" GroupName="sort" Tag="s1" Click="OnViewMenuClick" />
                                        <RadioMenuFlyoutItem x:Name="SortPackedItem" Text="main.sort_by_packed_size" GroupName="sort" Tag="s2" Click="OnViewMenuClick" />
                                        <RadioMenuFlyoutItem x:Name="SortModifiedItem" Text="main.sort_by_modified_date" GroupName="sort" Tag="s3" Click="OnViewMenuClick" />
                                        <RadioMenuFlyoutItem x:Name="SortTypeItem" Text="main.sort_by_type" GroupName="sort" Tag="s4" Click="OnViewMenuClick" />
                                        <MenuFlyoutSeparator />
                                        <RadioMenuFlyoutItem x:Name="SortAscItem" Text="main.ascending" GroupName="dir" Tag="d1" Click="OnViewMenuClick" />
                                        <RadioMenuFlyoutItem x:Name="SortDescItem" Text="main.descending" GroupName="dir" Tag="d0" Click="OnViewMenuClick" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <DropDownButton x:Name="MoreButton" Grid.Column="5" AutomationProperties.Name="main.more_options">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE700;" FontSize="14" />
                                    <TextBlock Text="main.more_options" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="TestItem" Text="main.test_integrity" KeyboardAcceleratorTextOverride="Ctrl+T" Click="OnTestClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="ArchiveInfoItem" Text="main.archive_information" KeyboardAcceleratorTextOverride="Alt+Enter" Click="OnArchiveInfoClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="HashArchiveItem" Text="main.hash_values_archive" Click="OnHashArchiveClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C3;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="VerifySumsItem" Text="sums.verify_menu" Click="OnVerifySumsClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="ScanItem" Text="main.scan_malware" Click="OnScanClick"
                                                        ToolTipService.ToolTip="main.hands_every_file_archive_antivirus">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEA18;" Foreground="{ThemeResource SystemFillColorCautionBrush}" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="VirusTotalItem" Text="main.virustotal_lookup" Click="OnVirusTotalArchiveClick"
                                                        ToolTipService.ToolTip="main.virustotal_lookup_tip">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" Foreground="{ThemeResource SystemFillColorCautionBrush}" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <!-- Repacking (DESIGN.md "重新封裝"): shown by ShowArchive for the archives they apply to -->
                                        <MenuFlyoutItem x:Name="ConvertItem" Text="main.convert_archive_format" Click="OnConvertClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AB;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="RemovePasswordItem" Text="main.remove_archive_password" Click="OnRemovePasswordClick" Visibility="Collapsed">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE785;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="UpgradeItem" Text="main.upgrade_archive" Click="OnUpgradeClick" Visibility="Collapsed"
                                                        ToolTipService.ToolTip="main.upgrade_archive_tip">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                    <StackPanel x:Name="EncodingPanel" Grid.Column="7" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="main.filename_encoding" VerticalAlignment="Center" Opacity="0.8" />
                        <ComboBox x:Name="EncodingCombo" MinWidth="170" SelectionChanged="OnEncodingChanged" AutomationProperties.Name="main.filename_encoding" />
                    </StackPanel>
                </Grid>

                <!-- Second row: up one level, the whole-row path (breadcrumb), search -->
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Click="OnBackClick" ToolTipService.ToolTip="main.back_home_ctrl_w" AutomationProperties.Name="main.home">
                        <FontIcon Glyph="&#xE80F;" FontSize="14" />
                    </Button>
                    <Button x:Name="UpButton" Grid.Column="1" Click="OnUpClick" ToolTipService.ToolTip="main.up_one_level_backspace" AutomationProperties.Name="main.up_one_level">
                        <FontIcon Glyph="&#xE74A;" FontSize="14" />
                    </Button>
                    <!-- Path box: has a background and border (same height as the search box and buttons), with an archive icon in front, so it can be seen that the path is clickable -->
                    <Border x:Name="PathBox" Grid.Column="2" Height="32" CornerRadius="4" BorderThickness="1" Padding="10,0,6,0"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{ThemeResource ControlFillColorDefaultBrush}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center">
                                <FontIcon x:Name="PathGlyph" Glyph="&#xE7B8;" FontSize="14" Opacity="0.8" VerticalAlignment="Center" />
                                <Image x:Name="PathIcon" Width="18" Height="18" Visibility="Collapsed" VerticalAlignment="Center" />
                            </Grid>
                            <BreadcrumbBar x:Name="Crumbs" Grid.Column="1" ItemClicked="OnCrumbClicked" VerticalAlignment="Center" AutomationProperties.Name="main.current_location">
                                <BreadcrumbBar.ItemTemplate>
                                    <DataTemplate x:DataType="local:CrumbItem">
                                        <Grid ToolTipService.ToolTip="{x:Bind Tip}">
                                            <TextBlock Text="{x:Bind Name}" Visibility="{x:Bind NormalVisibility}" />
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Visibility="{x:Bind LastVisibility}" />
                                        </Grid>
                                    </DataTemplate>
                                </BreadcrumbBar.ItemTemplate>
                            </BreadcrumbBar>
                        </Grid>
                    </Border>
                    <TextBox x:Name="SearchBox" Grid.Column="3" Width="220" PlaceholderText="main.search_ctrl_f" TextChanged="OnSearchTextChanged"
                             AutomationProperties.Name="main.search" />
                </Grid>

                <StackPanel Grid.Row="2" Spacing="6">
                    <!-- one-line notices (MainWindow::ShowNotice): an InfoBar needs three times the height -->
                    <Border x:Name="WelcomeStrip" Visibility="Collapsed" CornerRadius="6" BorderThickness="1" Padding="10,2,4,2"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" />
                    <Border x:Name="EncodingStrip" Visibility="Collapsed" CornerRadius="6" BorderThickness="1" Padding="10,2,4,2"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" />
                    <Border x:Name="SumsStrip" Visibility="Collapsed" CornerRadius="6" BorderThickness="1" Padding="10,2,4,2"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" />
                </StackPanel>

                <!-- Content area: folder tree on the left + list on the right -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TreeCol" Width="200" />
                        <ColumnDefinition x:Name="SplitCol" Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left column: the folder tree on top, the preview pane below (either can be off; alone it takes the whole column) -->
                    <Grid x:Name="LeftPane">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="TreeRow" Height="*" />
                        <RowDefinition x:Name="PaneSplitRow" Height="8" />
                        <RowDefinition x:Name="PaneRow" Height="260" />
                    </Grid.RowDefinitions>
                    <Border x:Name="TreePane" CornerRadius="8" BorderThickness="1" Padding="4,6"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <TreeView x:Name="FolderTree" SelectionMode="Single" Expanding="OnTreeExpanding" ItemInvoked="OnTreeItemInvoked"
                                  CanDragItems="True" DragItemsStarting="OnTreeDragStarting" DragItemsCompleted="OnTreeDragCompleted" ContextRequested="OnTreeContextRequested"
                                  AutomationProperties.Name="main.folder_tree">
                            <!-- Shorter rows than the WinUI default (28 + margins = 32 px a row): 24 + 2 = 26 px -->
                            <TreeView.Resources>
                                <x:Double x:Key="TreeViewItemMinHeight">24</x:Double>
                                <x:Double x:Key="TreeViewItemMultiSelectCheckBoxMinHeight">24</x:Double>
                                <Thickness x:Key="TreeViewItemPresenterMargin">4,1</Thickness>
                                <Thickness x:Key="TreeViewItemPresenterPadding">0,2,0,2</Thickness>
                            </TreeView.Resources>
                            <TreeView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                                            <Border CornerRadius="4" Width="18" Height="18" Background="{Binding Content.GlyphBrush}" Opacity="0.2" Visibility="{Binding Content.TreeGlyphVisibility}" />
                                            <FontIcon Glyph="{Binding Content.Glyph}" FontSize="13" Foreground="{Binding Content.GlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Content.TreeGlyphVisibility}" />
                                            <Image Width="16" Height="16" Source="{Binding Content.RootIcon}" Visibility="{Binding Content.RootIconVisibility}" />
                                            <Image Width="16" Height="16" Source="{Binding Content.ShellIcon}" Visibility="{Binding Content.ShellIconVisibility}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Content.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Border>
                    <!-- Splitter between the tree and the preview pane: drag up / down (remembered), double click to restore -->
                    <Border x:Name="PaneSplitter" Grid.Row="1" Background="Transparent" ToolTipService.ToolTip="main.drag_resize_preview_pane_double" AutomationProperties.Name="main.preview_pane_splitter">
                        <Rectangle x:Name="PaneSplitterLine" Height="2" RadiusX="1" RadiusY="1" VerticalAlignment="Center" Margin="12,0" Opacity="0"
                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Border>
                    <Border x:Name="PreviewPaneHost" Grid.Row="2" CornerRadius="8" BorderThickness="1" Padding="8"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            Background="{ThemeResource LayerFillColorDefaultBrush}" AutomationProperties.Name="main.preview_pane" />
                    </Grid>

                    <!-- Splitter between the folder tree and the list: drag left / right to change the width of the tree (remembered) -->
                    <Border x:Name="TreeSplitter" Grid.Column="1" Background="Transparent" ToolTipService.ToolTip="main.drag_resize_folder_tree_double" AutomationProperties.Name="main.folder_tree_splitter">
                        <Rectangle x:Name="TreeSplitterLine" Width="2" RadiusX="1" RadiusY="1" HorizontalAlignment="Center" Margin="0,12" Opacity="0"
                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Border>

                    <Grid Grid.Column="2">
                        <Border CornerRadius="8" BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- Column headers: click to sort. The blank on the left lines up with the checkbox column of the list -->
                                <!-- The header follows the list when it scrolls sideways (MainWindow::HookListScroll); it is clipped to the width of the list -->
                                <Grid x:Name="HeaderViewport">
                                <Grid x:Name="ListHeader" Padding="8,4,8,4" Background="Transparent" HorizontalAlignment="Left">
                                    <Grid.RenderTransform><TranslateTransform x:Name="HeaderShift" /></Grid.RenderTransform>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition x:Name="HeaderNameCol" Width="300" />
                                        <ColumnDefinition x:Name="HeaderPathCol" Width="0" />
                                        <ColumnDefinition x:Name="HeaderTypeCol" Width="62" />
                                        <ColumnDefinition x:Name="HeaderSizeCol" Width="78" />
                                        <ColumnDefinition x:Name="HeaderPackedCol" Width="78" />
                                        <ColumnDefinition x:Name="HeaderRatioCol" Width="0" />
                                        <ColumnDefinition x:Name="HeaderModifiedCol" Width="136" />
                                        <ColumnDefinition x:Name="HeaderEncCol" Width="0" />
                                        <ColumnDefinition x:Name="HeaderMethodCol" Width="0" />
                                        <ColumnDefinition x:Name="HeaderCrcCol" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="SelectAllBox" Width="22" MinWidth="0" Padding="0" Click="OnSelectAllClick"
                                              AutomationProperties.Name="main.select_all" ToolTipService.ToolTip="main.select_all_clear_selection" />
                                    <Button x:Name="SortNameButton" Grid.Column="1" Tag="0" Click="OnSortClick" Background="Transparent" BorderThickness="0"
                                            Padding="0,2" Margin="6,0,0,0" HorizontalAlignment="Left" AutomationProperties.Name="main.sort_by_name">
                                        <TextBlock x:Name="SortNameText" Text="main.name" Opacity="0.8" />
                                    </Button>
                                    <Button x:Name="SortPathButton" Grid.Column="2" Tag="5" Click="OnSortClick" Background="Transparent" BorderThickness="0"
                                            Padding="0,2" Margin="6,0,0,0" HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.Name="main.sort_by_location">
                                        <TextBlock x:Name="SortPathText" Text="main.location" Opacity="0.8" />
                                    </Button>
                                    <Button x:Name="SortTypeButton" Grid.Column="3" Tag="4" Click="OnSortClick" Background="Transparent" BorderThickness="0"
                                            Padding="0,2" Margin="6,0,0,0" HorizontalAlignment="Left" AutomationProperties.Name="main.sort_by_type">
                                        <TextBlock x:Name="SortTypeText" Text="main.type" Opacity="0.8" />
                                    </Button>
                                    <Button x:Name="SortSizeButton" Grid.Column="4" Tag="1" Click="OnSortClick" Background="Transparent" BorderThickness="0"
                                            Padding="0,2" HorizontalAlignment="Right" AutomationProperties.Name="main.sort_by_size">
                                        <TextBlock x:Name="SortSizeText" Text="main.size" Opacity="0.8" />
                                    </Button>
                                    <Button x:Name="SortPackedButton" Grid.Column="5" Tag="2" Click="OnSortClick" Background="Transparent" BorderThickness="0"
                                            Padding="0,2" HorizontalAlignment="Right" AutomationProperties.Name="main.sort_by_packed_size">
                                        <TextBlock x:Name="SortPackedText" Text="main.packed" Opacity="0.8" />
                                    </Button>
                                    <Button x:Name="SortRatioButton" Grid.Column="6" Tag="6" Click="OnSortClick" Background="Transparent" BorderThickness="0"
                                            Padding="0,2" HorizontalAlignment="Right" Visibility="Collapsed" AutomationProperties.Name="main.sort_by_ratio">
                                        <TextBlock x:Name="SortRatioText" Text="main.ratio" Opacity="0.8" />
                                    </Button>
                                    <Button x:Name="SortModifiedButton" Grid.Column="7" Tag="3" Click="OnSortClick" Background="Transparent" BorderThickness="0"
                                            Padding="0,2" Margin="10,0,0,0" HorizontalAlignment="Left" AutomationProperties.Name="main.sort_by_modified_date">
                                        <TextBlock x:Name="SortModifiedText" Text="main.modified" Opacity="0.8" />
                                    </Button>
                                    <Button x:Name="SortEncButton" Grid.Column="8" Tag="7" Click="OnSortClick" Background="Transparent" BorderThickness="0"
                                            Padding="0,2" Margin="6,0,0,0" HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.Name="main.sort_by_encrypted">
                                        <TextBlock x:Name="SortEncText" Text="main.col_encrypted" Opacity="0.8" />
                                    </Button>
                                    <Button x:Name="SortMethodButton" Grid.Column="9" Tag="9" Click="OnSortClick" Background="Transparent" BorderThickness="0"
                                            Padding="0,2" Margin="6,0,0,0" HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.Name="main.sort_by_method">
                                        <TextBlock x:Name="SortMethodText" Text="main.col_method" Opacity="0.8" />
                                    </Button>
                                    <Button x:Name="SortCrcButton" Grid.Column="10" Tag="8" Click="OnSortClick" Background="Transparent" BorderThickness="0"
                                            Padding="0,2" Margin="6,0,0,0" HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.Name="main.sort_by_crc">
                                        <TextBlock x:Name="SortCrcText" Text="main.col_crc" Opacity="0.8" />
                                    </Button>
                                </Grid>
                                </Grid>
                                <ListView x:Name="EntryList" Grid.Row="1" SelectionMode="Extended" Background="Transparent"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled"
                                          ContainerContentChanging="OnContainerChanging" SelectionChanged="OnEntrySelectionChanged"
                                          ContextRequested="OnEntryContextRequested" KeyDown="OnEntryKeyDown" CanDragItems="True" DragItemsStarting="OnEntryDragStarting" DragItemsCompleted="OnEntryDragCompleted"
                                          AutomationProperties.Name="main.archive_contents">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:EntryRow">
                                            <Grid Loaded="OnTemplateLoaded">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="3*" />
                                                    <ColumnDefinition Width="{x:Bind PathWidth}" />
                                                    <ColumnDefinition Width="62" />
                                                    <ColumnDefinition Width="78" />
                                                    <ColumnDefinition Width="78" />
