                                    <Border Style="{StaticResource SettingCard}">
                                        <StackPanel Spacing="6">
                                            <TextBox x:Name="CParamsBox" Header="main.custom_7_zip_parameters" PlaceholderText="main.e_g_mx_9_fb_64" AutomationProperties.Name="main.custom_parameters" />
                                            <TextBlock Text="main.passed_straight_compression_engine" Opacity="0.65" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="CResetAdvanced" Content="main.restore_template_s_settings" AutomationProperties.Name="main.restore_template_s_settings" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <StackPanel x:Name="CSide" Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Top">
                            <Border x:Name="CSourcesCard" Style="{StaticResource SettingCard}">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="CSourcesTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="CSourcesInfo" Opacity="0.65" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <StackPanel x:Name="CSourcesList" Spacing="2" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="CAddFiles" Content="main.add_files" AutomationProperties.Name="main.add_files_button" />
                                        <Button x:Name="CAddFolder" Content="main.add_folder" AutomationProperties.Name="main.add_folder_button" />
                                    </StackPanel>
                                    <TextBlock x:Name="CPasteHint" Text="main.you_can_also_paste_files_with" Opacity="0.65" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <Border Grid.Row="2" Style="{StaticResource SettingCard}" Padding="16,10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="CStatusText" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.85" />
                        <Button x:Name="CCancelButton" Grid.Column="1" Content="main.cancel" MinWidth="88" AutomationProperties.Name="main.cancel" />
                        <Button x:Name="CStartButton" Grid.Column="2" Content="main.start_compressing" MinWidth="120" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="main.start_compressing" />
                    </Grid>
                </Border>
            </Grid>

            <!-- opening an archive from nothing (Explorer, right-click): shown instead of the home page, after a short delay -->
            <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                <ProgressRing IsActive="True" Width="56" Height="56" />
                <TextBlock x:Name="LoadingText" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" Style="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>

            <!-- Busy -->
            <ProgressRing x:Name="BusyRing" IsActive="False" Visibility="Collapsed" Width="48" Height="48"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- Task panel (in the compact window the title bar and the frame are hidden, only the task card with the big moon stays) -->
        <Border x:Name="TaskPanel" Grid.Row="2" Visibility="Collapsed" Margin="20,0,20,16"
                CornerRadius="10" BorderThickness="1" Padding="14,8"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="TaskHeader">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="main.tasks" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TaskSummary" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <HyperlinkButton x:Name="BackgroundButton" Content="main.run_background" Visibility="Collapsed" Click="OnBackgroundClick"
                                         ToolTipService.ToolTip="main.hide_window_tasks_keep_running" AutomationProperties.Name="main.run_background" />
                        <HyperlinkButton Content="main.clear_finished" Click="OnClearFinishedClick" />
                        <Button x:Name="TaskCollapseButton" Click="OnTaskCollapseClick" Background="Transparent" BorderThickness="0" Padding="8,4"
                                ToolTipService.ToolTip="main.collapse_expand" AutomationProperties.Name="main.collapse_task_panel">
                            <FontIcon x:Name="TaskCollapseGlyph" Glyph="&#xE70D;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- ListView virtualization makes a row newly inserted at the top "jump above the visible range" without growing its height; there are few tasks, so ItemsControl + ScrollViewer is used -->
                <ScrollViewer x:Name="TaskScroll" Grid.Row="1" MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TaskList" ItemTemplate="{StaticResource TaskRowTemplate}" />
                </ScrollViewer>
                <!-- For the compact window (context menu actions) only: what to do when done; the options are bound to the settings directly -->
                <!-- the three options share the width (a long text wraps in its column), the button is in a row of its own: no text is hidden behind it -->
                <Grid x:Name="CompactOptions" Grid.Row="2" Visibility="Collapsed" Margin="0,2,0,0" ColumnSpacing="8" RowSpacing="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="main.when_done" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,6,0" />
                    <CheckBox x:Name="OptFirst" Grid.Column="1" MinWidth="0" Click="OnCompactOptionClick" />
                    <CheckBox x:Name="OptSecond" Grid.Column="2" MinWidth="0" Click="OnCompactOptionClick" />
                    <CheckBox x:Name="OptClose" Grid.Column="3" MinWidth="0" Click="OnCompactOptionClick" />
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <HyperlinkButton x:Name="CompactBackgroundButton" Content="main.run_background" Visibility="Collapsed" Click="OnBackgroundClick"
                                         ToolTipService.ToolTip="main.hide_window_tasks_keep_running" AutomationProperties.Name="main.run_background" />
                <!-- Appears when all tasks are finished: success is "Done", with a failure it is "Close"; Enter and Esc can close it too -->
                        <Button x:Name="CompactDoneButton" Style="{StaticResource AccentButtonStyle}" MinWidth="88" Visibility="Collapsed" Click="OnCompactDoneClick" AutomationProperties.Name="main.done">
                            <Button.KeyboardAccelerators><KeyboardAccelerator Key="Escape" /></Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Window>
