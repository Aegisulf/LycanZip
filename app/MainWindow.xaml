<Window
    x:Class="LycanZip.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LycanZip"
    Title="LycanZip">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>


    <!-- Outer layer: the background layer and the content each have a cell, so the background (the big halo / wolf shadow) does not change the height of the content row -->
    <Grid>
        <!-- Background layer: gradient (changes with the accent theme and dark / light) + start page scene (halo, stars, wolf shadow). Does not intercept mouse events -->
        <Grid x:Name="BackdropLayer" IsHitTestVisible="False">
            <Rectangle x:Name="BgFill" />
            <Rectangle x:Name="BgGlow" />
            <Grid x:Name="HomeScene" Visibility="Collapsed">
                <Ellipse x:Name="MoonHalo" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Ellipse x:Name="MilkyBand" Height="200" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform Angle="-26" /></Ellipse.RenderTransform>
                </Ellipse>
                <Canvas x:Name="Stars" />
                <Path x:Name="WolfShade" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stretch="Uniform"
