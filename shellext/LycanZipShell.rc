#pragma code_page(65001)
#include <winver.h>
#include "lycan/version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LYCAN_VERSION_RC
 PRODUCTVERSION LYCAN_VERSION_RC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "LycanZip contributors"
            VALUE "FileDescription", "LycanZip File Archiver (Explorer context menu)"
            VALUE "FileVersion", LYCAN_VERSION_RC_STRING
            VALUE "InternalName", "LycanZipShell"
            VALUE "LegalCopyright", "Copyright (c) LycanZip File Archiver. MIT License."
            VALUE "OriginalFilename", "LycanZipShell.dll"
            VALUE "ProductName", "LycanZip"
            VALUE "ProductVersion", LYCAN_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
